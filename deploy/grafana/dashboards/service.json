{
 "uid": "service",
 "title": "Chaos Panel · Service",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "timezone": "browser",
 "tags": [
  "chaos-panel"
 ],
 "templating": {
  "list": [
   {
    "name": "service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "query": {
     "query": "label_values(edge_requests_total, service)",
     "refId": "svc"
    },
    "definition": "label_values(edge_requests_total, service)",
    "refresh": 2,
    "current": {
     "text": "order-svc",
     "value": "order-svc"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Outgoing calls from $service",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (dst, outcome) (rate(edge_requests_total{service=\"$service\"}[30s]))",
     "legendFormat": "→ {{dst}} ({{outcome}})",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Incoming calls to $service",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (src, outcome) (rate(edge_requests_total{dst=\"$service\"}[30s]))",
     "legendFormat": "{{src}} → ({{outcome}})",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "p95 latency of outgoing calls",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.95, sum by (le, dst) (rate(edge_request_duration_seconds_bucket{service=\"$service\"}[1m])))",
     "legendFormat": "→ {{dst}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Error ratio of outgoing calls",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(rate(edge_requests_total{service=\"$service\",outcome=\"error\"}[1m])) / sum(rate(edge_requests_total{service=\"$service\"}[1m]))",
     "legendFormat": "errors",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  }
 ]
}
