{
 "uid": "kafka",
 "title": "Chaos Panel · Kafka",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "timezone": "browser",
 "tags": [
  "chaos-panel"
 ],
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Consumer lag by group",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (consumergroup) (kafka_consumergroup_lag)",
     "legendFormat": "{{consumergroup}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Messages in per topic",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset{topic=~\"orders.*\"}[1m]))",
     "legendFormat": "{{topic}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "mps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
