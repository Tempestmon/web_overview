<!-- The demo writes a few rows per second; ClickHouse's defaults assume a
     server, not a 4 GB laptop VM shared with Kafka. It derives its memory
     budget from the container's cgroup limit, so keep the caches small and
     the compose mem_limit modest. -->
<clickhouse>
    <mark_cache_size>33554432</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <max_concurrent_queries>8</max_concurrent_queries>
    <logger>
        <level>warning</level>
    </logger>
</clickhouse>
